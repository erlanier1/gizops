# PayPal REST app (add to your .env.local file)
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_BRAND_NAME=GizOps
PAYPAL_INVOICER_NAME=GizOps

# App URL (change based on environment)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional website contact lead email notifications
RESEND_API_KEY=your_resend_api_key
CONTACT_FROM_EMAIL=GizOps <noreply@yourdomain.com>
